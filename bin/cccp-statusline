#!/bin/bash
#
# Collect session status data for CCCP.
#
# Reads the statusLine JSON payload from stdin and atomically writes it, plus an
# `updated_at` stamp, as this session's telemetry snapshot for other programs in
# this plugin. Snapshot tree and field contract: docs/telemetry-snapshots.md.
# 
# Produces no output
#
# --plugin-data <dir>   Data directory (required).
# --passthrough         Copy stdin to stdout, for piping into another
#                       statusLine command.

data_dir=""
passthrough=false
include_auth=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --plugin-data) data_dir="$2"; shift 2 ;;
        --plugin-data=*) data_dir="${1#--plugin-data=}"; shift ;;
        --passthrough) passthrough=true; shift ;;
        --include-auth) include_auth=true; shift ;;
        *) shift ;;
    esac
done

if [[ -z "$data_dir" ]]; then
    echo "cccp-statusline: --plugin-data is required" >&2
    exit 1
fi

input=$(cat)

# This is the Claude Code producer of the snapshot tree:
# telemetry/<v-major|inline>/claude-code/ under --plugin-data, which is the tree
# root (the map is in bin/cccp; the contract is docs/telemetry-snapshots.md).
#
# Readers glob the producer level, so `claude-code` here is a free choice. The
# version segment above it is not: claude-tokens and cccp derive it from the same
# plugin.json by the same rule (major digits before the first dot, .git means
# inline), and the three must stay identical. A divergence silently strands the
# reader, which is exactly the failure jhs/cccp#14 was.
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [[ -d "$root/.git" ]]; then
    version_segment="inline"
else
    major=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([0-9][0-9]*\)\..*/\1/p' \
        "$root/.claude-plugin/plugin.json" 2>/dev/null | head -1)
    if [[ -n "$major" ]]; then
        version_segment="v$major"
    else
        version_segment="unknown"
    fi
fi
tele_dir="$data_dir/telemetry/$version_segment/claude-code"

# Write claude auth status. Cached with 5h TTL.
auth_file="$tele_dir/auth-status.json"
if ! [[ -f "$auth_file" ]] || [[ -z $(find "$auth_file" -mmin -300 -print 2>/dev/null) ]]; then
    mkdir -p "$tele_dir" 2>/dev/null
    auth_tmp=$(mktemp "${auth_file}.XXXXXX")
    if claude auth status 2>/dev/null >"$auth_tmp"; then
        mv "$auth_tmp" "$auth_file" 2>/dev/null || rm -f "$auth_tmp" 2>/dev/null
    else
        rm -f "$auth_tmp"
    fi
fi

# Write session status data to a per-session file for claude-tokens.
#
# The payload goes out verbatim apart from `updated_at`: it already satisfies
# every field the snapshot contract requires (docs/telemetry-snapshots.md), so
# there is nothing to translate. `updated_at` is the one thing the payload cannot
# supply - it is when THIS read happened, and it has to travel inside the file
# because a snapshot copied to another machine takes its mtime from the copy.
sid=$(printf '%s' "$input" | jq -r '.session_id // empty')
if [[ -n "$sid" ]]; then
    mkdir -p "$tele_dir" 2>/dev/null
    tmp="$tele_dir/$sid.json.tmp"
    if printf '%s' "$input" | jq --argjson now "$(date +%s)" '. + {updated_at: $now}' > "$tmp"; then
        mv "$tmp" "$tele_dir/$sid.json"
    else
        rm -f "$tmp"
    fi
fi

if $passthrough; then
    if $include_auth && [[ -f "$auth_file" ]]; then
        printf '%s' "$input" | jq --slurpfile auth "$auth_file" '. + {__auth: $auth[0]}'
    else
        printf '%s' "$input"
    fi
fi
