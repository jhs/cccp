#!/usr/bin/env python3
"""claude-tokens - report or watch agent sessions' context/token usage.

See skills/token-aware/SKILL.md for usage.

Reads the per-session snapshots under
$CCCP_PLUGIN_DATA/telemetry/<v-major|inline>/<producer>/<session_id>.json -
tree, field contract and the reason for the producer glob are in
docs/telemetry-snapshots.md. bin/cccp-statusline writes the Claude Code ones.
'status' prints a one-shot summary; 'watch' streams milestone events for the
Monitor tool. Both take any number of targets - session ids or comrade ids (see
match_target) - and answer for each in one process off one directory scan. With
no target at all: $CLAUDE_CODE_SESSION_ID, else the most recent snapshot.

Resolving a comrade id to its session lives here too, and 'status --json' reports
it (comrade_id, transcript_path, cwd, snapshot_path) alongside the usage fields.
Not scope creep: match_target already had to know how each harness anchors its
ids, and a resolved snapshot is already open, so the alternative was every caller
re-deriving the anchoring rule in a shell pipeline and picking a silent winner on
a 6-hex collision (#37).
"""

import argparse
import json
import os
import re
import sys
import time
from pathlib import Path


def _version_segment():
    """The telemetry partition this plugin copy owns: `v<major>` from its own
    plugin.json, or `inline` for a checkout (whose version is whatever the
    branch says, not a release).

    bin/cccp-statusline WRITES the directory this names and derives it from the
    same file by the same rule - major digits before the first dot, .git means
    inline. Keep the two identical: a divergence strands the reader silently,
    which is exactly the failure jhs/cccp#14 was."""
    root = Path(__file__).resolve().parent.parent
    if (root / ".git").exists():
        return "inline"
    try:
        raw = json.loads((root / ".claude-plugin" / "plugin.json").read_text())
        m = re.match(r"(\d+)\.", str(raw.get("version", "")))
        return f"v{m.group(1)}" if m else "unknown"
    except (OSError, ValueError):
        return "unknown"


def _data_dir():
    """The version partition holding every producer's snapshots."""
    d = os.environ.get("CCCP_PLUGIN_DATA")
    if not d:
        print("CCCP_PLUGIN_DATA is not set -- is the cccp plugin enabled?",
              file=sys.stderr)
        sys.exit(1)
    return Path(d) / "telemetry" / _version_segment()


DEFAULT_THRESHOLDS = (50, 75, 90, 95)

THRESHOLD_SPEC = re.compile(r"\s*(\d+(?:\.\d+)?)\s*%?\s*(.*)", re.S)


def parse_threshold(spec):
    """One `--threshold` value as (percent, reminder or None).

    The grammar is `PCT[%][ REMINDER]` - a number, an optional percent sign, and
    everything after it is a reminder to be played back when that milestone is
    crossed. No separator punctuation, so a breakpoint is written the way it
    would be said (`90% prepare to terminate`), and one whose text trails off to
    nothing is simply unlabelled rather than an error to explain."""
    m = THRESHOLD_SPEC.fullmatch(spec)
    if not m:
        raise argparse.ArgumentTypeError(f"expected `PCT[%][ REMINDER]`, got {spec!r}")
    pct = float(m.group(1))
    if not 0 < pct <= 100:
        raise argparse.ArgumentTypeError(f"percent must be over 0 and at most 100, got {pct:g}")
    return pct, (m.group(2).strip() or None)


def threshold_plan(specs):
    """The watch's breakpoints as an ordered {percent: reminder or None}.

    A percent given twice is fatal rather than deduplicated. Collapsing two
    breakpoints silently drops whichever reminder lost, and a dropped reminder
    does not go wrong until the crossing it was meant to speak at - by which
    time the run is hours old. Refusing at parse time costs an agent one
    corrected command."""
    plan = {}
    for pct, reminder in specs:
        if pct in plan:
            print(f"--threshold {pct:g} given twice", file=sys.stderr)
            sys.exit(1)
        plan[pct] = reminder
    return dict(sorted(plan.items()))


def load_snapshot(path):
    """Parse one snapshot, or None if it is unreadable or not a snapshot.

    The producer glob sweeps whole directories, which hold sidecar files too
    (claude-code/auth-status.json). `session_id` is what makes a file a snapshot,
    so requiring it is both the contract check and the sidecar filter."""
    try:
        payload = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(payload, dict) or not payload.get("session_id"):
        return None
    return payload


def scan():
    """Every snapshot in the partition, as (path, payload).

    One pass, however many targets are being answered for: the alternative is a
    directory scan per target, which is what made watching a fleet cost a process
    per member. Producer directories are globbed rather than named - a session id
    is unique, so which program wrote the file is not part of its identity, and a
    harness added later is found for free (docs/telemetry-snapshots.md)."""
    snaps = []
    for path in _data_dir().glob("*/*.json"):
        payload = load_snapshot(path)
        if payload is not None:
            snaps.append((path, payload))
    return snaps


def newest_session(snaps):
    """Session id of the most recent snapshot, or None when there are none."""
    best = None
    for path, payload in snaps:
        try:
            # Ordering only, so mtime is a fair stand-in for a snapshot written
            # before `updated_at` existed. A reported AGE is not: see reading_age.
            when = payload.get("updated_at") or path.stat().st_mtime
        except OSError:
            continue
        if best is None or when > best[0]:
            best = (when, payload["session_id"])
    return best[1] if best else None


def resolve_targets(given, snaps):
    """What to report on: what was asked for, else this session, else the newest.

    An empty list means there was nothing to report on and nothing to guess."""
    if given:
        return given
    for var in ("CLAUDE_CODE_SESSION_ID", "CLAUDE_SESSION_ID"):
        v = os.environ.get(var)
        if v:
            return [v]
    sid = newest_session(snaps)
    return [sid] if sid else []


COMRADE_TAIL = re.compile(r"(cc|pi)-([0-9a-f]{6})", re.I)

# Which harness tag a producer directory implies, for the REVERSE derivation in
# comrade_id() only. docs/telemetry-snapshots.md is emphatic that the producer
# directory is not part of a snapshot's identity, and that still holds: a session
# id is unique, so forward matching never consults this. But a bare session id
# cannot say which end to anchor, and the producer is the only signal on disk. It
# is read as a hint about how to SPELL an id, never as a claim about whose
# session it is - so a producer missing from this table yields no comrade id at
# all rather than a guessed one.
PRODUCER_HARNESS = {"claude-code": "cc", "pi": "pi"}


def comrade_tag(session_id, harness):
    """The 6 hex a comrade id carries for this session under this harness.

    THE ANCHORING RULE, in one place because it is the piece every hand-rolled
    caller got wrong (#37). The two harnesses take their 6 hex from OPPOSITE ends:
    `cc` the FIRST 6 characters of the session id (bin/cccp comrade_id), `pi` the
    LAST 6 hex (integrations/pi/cccp-comrade.ts resolveEnvironment).

    Pi's is not an arbitrary difference. Pi session ids are UUIDv7, which are
    time-ordered, so the leading hex is a timestamp and siblings started in the
    same moment share a prefix; taking the random tail is what keeps them apart.

    An unknown harness returns None rather than defaulting to one end. A guess
    here yields an id that looks right and names the wrong session."""
    if harness == "cc":
        return session_id[:6].lower()
    if harness == "pi":
        return session_id.replace("-", "")[-6:].lower()
    return None


def match_target(target, snaps):
    """The snapshots one target names, as a list of (path, payload).

    A target is either a full session id, matched exactly, or a comrade id whose
    6-hex tail is matched at whichever end comrade_tag anchors it. Accepting
    comrade ids at all is the point: every caller was otherwise hand-rolling this
    as a shell pipeline, and one of the two anchors is backwards from the obvious.

    Any `user@host:` head is dropped. Snapshots are portable between machines by
    design, so the host a file sits on is not a reliable filter on whose reading
    it holds."""
    tail = target.rsplit(":", 1)[-1]
    m = COMRADE_TAIL.fullmatch(tail)
    if not m:
        return [(p, s) for p, s in snaps if s["session_id"] == target]
    harness, want = m.group(1).lower(), m.group(2).lower()
    return [(p, s) for p, s in snaps
            if comrade_tag(str(s["session_id"]), harness) == want]


def comrade_id(target, session_id, producer):
    """The comrade id a resolved snapshot belongs to, or None.

    Forward lookup already has one - the caller typed it - so it is echoed back
    unchanged, `user@host:` head and all. Only a session-id target has to build
    one, and what it can build is the bare `cc-4f2a1b` tag: a snapshot records no
    user and no host, deliberately, because snapshots are portable between
    machines and a host baked into one becomes a lie the moment it is copied."""
    if COMRADE_TAIL.fullmatch(target.rsplit(":", 1)[-1]):
        return target
    harness = PRODUCER_HARNESS.get(producer)
    tag = comrade_tag(session_id, harness)
    return f"{harness}-{tag}" if tag else None


def workspace_dir(payload):
    """The working tree a session is in, or None.

    `cwd` is the Claude Code statusLine payload's spelling; `workspace` carries
    the same thing when a producer reports it that way. A producer with neither
    returns None rather than having a directory invented for it."""
    if payload.get("cwd"):
        return payload["cwd"]
    ws = payload.get("workspace") or {}
    return ws.get("current_dir") or ws.get("project_dir") or None


def reading_age(payload):
    """Seconds since the reading was taken, or None when the snapshot says.

    Deliberately no mtime fallback. Snapshots are portable between machines, so
    mtime can be the time of a copy rather than of a reading, and a stale reading
    that looks fresh is worse than one that admits it does not know."""
    when = payload.get("updated_at")
    return None if when is None else time.time() - when


def report(target, snaps):
    """What one target resolves to: a reading, or why there is not one.

    Both counts an anchored match can get wrong are named rather than papered
    over. Zero is `no snapshot`; more than one is `ambiguous`, never the first
    hit - 6 hex is short enough to collide as snapshots accumulate, and silently
    answering for the wrong session is the failure worth avoiding here.

    The identity fields (comrade_id, transcript_path, cwd, snapshot_path) are set
    from a payload this function has already parsed, and they survive a `no
    reading` return: WHICH session a target names is known as soon as it resolves,
    whether or not that session has reported usage yet. Answering "who is this,
    and where do I go read them" was otherwise a hand-rolled glob over this same
    directory that duplicated the anchoring rule and picked a silent winner when
    6 hex collided (#37) - and the snapshot was already open here."""
    r = {"target": target}
    hits = match_target(target, snaps)
    if not hits:
        return dict(r, error="no snapshot")
    if len(hits) > 1:
        return dict(r, error="ambiguous",
                    matches=sorted(s["session_id"] for _, s in hits))
    path, payload = hits[0]
    sid = str(payload["session_id"])
    producer = path.parent.name
    r.update(session_id=payload["session_id"],
             session_name=payload.get("session_name"),
             producer=producer,
             model=(payload.get("model") or {}).get("display_name"),
             comrade_id=comrade_id(target, sid, producer),
             snapshot_path=str(path),
             transcript_path=payload.get("transcript_path"),
             cwd=workspace_dir(payload))
    m = metrics(payload)
    if m is None:
        return dict(r, error="no reading")
    return dict(r, **m, updated_at=payload.get("updated_at"),
                age=reading_age(payload))


def humanize(n):
    """840 -> '840', 15700 -> '15.7k', 1000000 -> '1M'."""
    n = float(n)
    if n < 1000:
        return str(int(round(n)))
    if n < 1_000_000:
        v = n / 1000
        return f"{v:.0f}k" if v == int(v) else f"{v:.1f}k"
    v = n / 1_000_000
    return f"{v:.0f}M" if v == int(v) else f"{v:.1f}M"


def fmt_elapsed(seconds):
    seconds = int(round(seconds))
    if seconds < 60:
        return f"{seconds}s"
    m, s = divmod(seconds, 60)
    if m < 60:
        return f"{m}m{s:02d}s" if s else f"{m}m"
    h, m = divmod(m, 60)
    return f"{h}h{m:02d}m"


def metrics(payload):
    """Extract usage fields, or None when there is no reading yet (fresh/compacted).

    Two spellings of one numerator: `total_tokens` for a producer that measures
    context as a single number (Pi), input+output for one that reports a split
    (the Claude Code statusLine payload). A window size with NEITHER is not a
    reading - saying 0% because nothing counted the tokens is the confident-lie
    failure this file exists to avoid."""
    cw = payload.get("context_window") or {}
    size = cw.get("context_window_size") or 0
    used = cw.get("total_tokens")
    if used is None and ("total_input_tokens" in cw or "total_output_tokens" in cw):
        used = (cw.get("total_input_tokens") or 0) + (cw.get("total_output_tokens") or 0)
    if not size or used is None:
        return None
    pct = cw.get("used_percentage")
    if pct is None:
        pct = used / size * 100
    return {"pct": pct, "used": used, "size": size}


AGE_UNKNOWN = "unknown"


def summary(m, age=None):
    """One usage line. `age` is seconds, AGE_UNKNOWN, or None to omit it."""
    parts = [f"{m['pct']:.0f}% ({humanize(m['used'])}/{humanize(m['size'])})"]
    if age == AGE_UNKNOWN:
        parts.append("snapshot age unknown")
    elif age is not None:
        parts.append(f"snapshot {fmt_elapsed(age)} old")
    return " | ".join(parts)


def status_line(r, terse):
    """One target's reading, or the reason there is not one, as text.

    `terse` is on once targets are labelled: a setup hint is worth spelling out
    when a session asks about itself, and is noise repeated down a fleet."""
    err = r.get("error")
    if err == "ambiguous":
        return (f"ambiguous: {len(r['matches'])} match ("
                + ", ".join(sid[:8] + "\u2026" for sid in r["matches"]) + ")")
    if err == "no snapshot":
        return "no snapshot" if terse else (
            "No snapshot yet. The statusLine side-write may not be wired up "
            "(see skills/token-aware/SKILL.md Setup) or no render has fired "
            "since this session started.")
    if err == "no reading":
        return "no reading yet" if terse else (
            "Snapshot has no context_window data yet "
            "(fresh session or just compacted)")
    age = r.get("age")
    return summary(r, AGE_UNKNOWN if age is None else age)


def no_targets(stream):
    """Nothing named, nothing in the env, nothing on disk to fall back to.

    `watch` says this on stdout because that is the stream the Monitor tool
    reads; `status` keeps it on stderr, where a shell caller expects it."""
    print("No session id and no snapshots in data dir "
          "-- is the statusLine side-write installed?", file=stream, flush=True)
    return 1


def cmd_status(args):
    snaps = scan()
    targets = resolve_targets(args.sessions, snaps)
    if not targets:
        return no_targets(sys.stderr)
    results = [report(t, snaps) for t in targets]
    if args.json:
        print(json.dumps(results, indent=2))
        return 0
    # One target is answering about itself and needs no label, which also keeps
    # the single-session output the token-aware skill documents byte-identical.
    label = len(results) > 1
    for r in results:
        line = status_line(r, terse=label)
        print(f"{r['target']}: {line}" if label else line)
    return 0


def advance(w, r, now, plan):
    """Fold one reading into one target's watch, yielding the events it earns.

    `plan` is {percent: reminder or None}. A problem is announced when it starts,
    not every poll: a fleet watch that reprinted `no snapshot` per target per
    interval would bury the crossings it exists to surface."""
    if "pct" not in r:
        if r.get("error") != w["problem"]:
            w["problem"] = r.get("error")
            yield dict(r, event="waiting")
        return
    w["problem"] = None

    if w["prev"] is None:
        # Armed before the event is yielded, because breakpoints this session
        # started too late to see are part of what the start line reports - and
        # they are reported with their reminders, not just their percentages. A
        # caller told only that "25% already passed" has been told it lost
        # something without being told what, which is the silent loss this
        # feature exists to prevent, merely moved to the other end of the run.
        w["armed"] = {t for t in plan if r["pct"] >= t}
        yield dict(r, event="start",
                   already_passed=[{"threshold": t, "reminder": plan[t]} for t in sorted(w["armed"])])
        w["prev"] = {"t": now, "pct": r["pct"], "used": r["used"]}
        return

    for t in plan:
        if t in w["armed"] or r["pct"] < t:
            continue
        w["armed"].add(t)
        prev = w["prev"]
        dt = now - prev["t"]
        vel = (r["used"] - prev["used"]) / dt * 60 if dt > 0 else 0
        etas = {}
        if vel > 0:
            for x in (x for x in plan if x > t):
                want = x / 100 * r["size"]
                if want > r["used"]:
                    etas[x] = (want - r["used"]) / vel * 60
        # `reminder` is always present, null when the breakpoint carried none, so
        # a --json consumer never has to tell a missing key from an unlabelled one.
        yield dict(r, event="crossed", threshold=t, reminder=plan[t], since_seconds=dt,
                   since_pct=prev["pct"], since_used=prev["used"],
                   velocity_per_min=vel, eta_seconds=etas)
        w["prev"] = {"t": now, "pct": r["pct"], "used": r["used"]}


def watch_line(e):
    """One watch event as text, without its label."""
    if e["event"] == "waiting":
        if e.get("error") == "no snapshot":
            return "Waiting for first snapshot..."
        if e.get("error") == "no reading":
            return "Waiting for first reading..."
        return status_line(e, terse=True)
    if e["event"] == "start":
        line = "Start watch: " + summary(e)
        # A breakpoint below where the watch started never speaks. Saying so once
        # is the difference between an agent knowing an instruction is not coming
        # and assuming one is: see the `ambiguous` case for the same instinct.
        # Each is echoed as the caller wrote it - `PCT[ REMINDER]`, its own
        # --threshold argument handed back - so the words are recognisably its
        # own, and "SET TOO LATE" says whose fault that is without shouting the
        # instruction itself, which is the one thing here that will not happen.
        if e["already_passed"]:
            entries = "; ".join(f"{p['threshold']:g}%" + (f" {p['reminder']}" if p["reminder"] else "")
                                for p in e["already_passed"])
            line += f" | SET TOO LATE, WILL NOT FIRE: {entries}"
        return line
    etas = ", ".join(f"to {x:g}% ~{fmt_elapsed(secs)}"
                     for x, secs in e["eta_seconds"].items())
    line = (f"Crossed {e['threshold']:g}%: {summary(e)} "
            f"(+{fmt_elapsed(e['since_seconds'])} since "
            f"{e['since_pct']:.0f}%/{humanize(e['since_used'])}, "
            f"~{humanize(e['velocity_per_min'])}/min avg"
            + (f", ETA {etas}" if etas else "") + ")")
    # Last, behind the `|` that `status` already separates with, and shouted. The
    # numbers are why the line is believable; the reminder is the only part that
    # asks for an action, and the end of a notification is where an agent's
    # attention actually lands. The caps carry it there - the same device the
    # logging style guide spends on WARN and ERROR, and it survives being read by
    # a human in a terminal, which `**bold**` would not.
    return line + (f" | REMINDER: {e['reminder']}" if e["reminder"] else "")


def cmd_watch(args):
    targets = resolve_targets(args.sessions, scan())
    if not targets:
        return no_targets(sys.stdout)
    plan = threshold_plan(args.thresholds) if args.thresholds else {t: None for t in DEFAULT_THRESHOLDS}
    # A list, not a dict: the same target twice is a caller's business, not a
    # collision to silently collapse.
    watches = [{"target": t, "prev": None, "armed": set(), "problem": None}
               for t in targets]
    label = len(watches) > 1

    while True:
        # Re-scanned every poll: a session that has not written its first
        # snapshot yet, or writes it from a producer directory nobody named, is
        # picked up whenever it appears.
        snaps = scan()
        now = time.time()
        for w in watches:
            for e in advance(w, report(w["target"], snaps), now, plan):
                if args.json:
                    print(json.dumps(e), flush=True)
                else:
                    line = watch_line(e)
                    print(f"{e['target']}: {line}" if label else line, flush=True)
        time.sleep(args.interval)


TARGET_HELP = ("Session id or comrade id (`user@host:cc-4f2a1b`, `pi-99ff01`); "
               "repeatable (default: $CLAUDE_CODE_SESSION_ID)")


def main():
    ap = argparse.ArgumentParser(description="Report or watch context/token usage")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status", help="Print a one-shot usage summary")
    s.add_argument("sessions", nargs="*", metavar="TARGET", help=TARGET_HELP)
    s.add_argument("--json", action="store_true", help="Emit one JSON array of results")
    s.set_defaults(func=cmd_status)

    w = sub.add_parser("watch", help="Stream milestone events for the Monitor tool")
    w.add_argument("sessions", nargs="*", metavar="TARGET", help=TARGET_HELP)
    w.add_argument("--interval", type=float, default=5.0, help="Poll seconds (default 5)")
    w.add_argument("--threshold", "-t", type=parse_threshold, action="append", dest="thresholds",
                   metavar="SPEC", help="Milestone to alert on as `PCT[%% REMINDER]`; repeatable. The reminder, "
                   "if any, is played back verbatim on the crossing (default: 50 75 90 95, unlabelled)")
    w.add_argument("--json", action="store_true", help="Emit one JSON object per event")
    w.set_defaults(func=cmd_watch)

    args = ap.parse_args()
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
