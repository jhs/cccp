#!/usr/bin/env python3
"""claude-tokens - report or watch an agent session's context/token usage.

See skills/token-aware/SKILL.md for usage.

Reads the per-session snapshots under
$CCCP_PLUGIN_DATA/telemetry/<v-major|inline>/<producer>/<session_id>.json -
tree, field contract and the reason for the producer glob are in
docs/telemetry-snapshots.md. bin/cccp-statusline writes the Claude Code ones.
'status' prints a one-shot summary; 'watch' streams milestone events for the
Monitor tool. Session id resolves from the optional positional arg, else
$CLAUDE_CODE_SESSION_ID, else the most recent snapshot on disk.
"""

import argparse
import glob
import json
import os
import re
import sys
import time
from pathlib import Path


def _version_segment():
    """The telemetry partition this plugin copy owns: `v<major>` from its own
    plugin.json, or `inline` for a checkout (whose version is whatever the
    branch says, not a release).

    bin/cccp-statusline WRITES the directory this names and derives it from the
    same file by the same rule - major digits before the first dot, .git means
    inline. Keep the two identical: a divergence strands the reader silently,
    which is exactly the failure jhs/cccp#14 was."""
    root = Path(__file__).resolve().parent.parent
    if (root / ".git").exists():
        return "inline"
    try:
        raw = json.loads((root / ".claude-plugin" / "plugin.json").read_text())
        m = re.match(r"(\d+)\.", str(raw.get("version", "")))
        return f"v{m.group(1)}" if m else "unknown"
    except (OSError, ValueError):
        return "unknown"


def _data_dir():
    """The version partition holding every producer's snapshots."""
    d = os.environ.get("CCCP_PLUGIN_DATA")
    if not d:
        print("CCCP_PLUGIN_DATA is not set -- is the cccp plugin enabled?",
              file=sys.stderr)
        sys.exit(1)
    return Path(d) / "telemetry" / _version_segment()


DEFAULT_THRESHOLDS = (50, 75, 90, 95)


def load_snapshot(path):
    """Parse one snapshot, or None if it is unreadable or not a snapshot.

    The producer glob sweeps whole directories, which hold sidecar files too
    (claude-code/auth-status.json). `session_id` is what makes a file a snapshot,
    so requiring it is both the contract check and the sidecar filter."""
    try:
        payload = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(payload, dict) or not payload.get("session_id"):
        return None
    return payload


def newest_session():
    """Session id of the most recent snapshot in the partition, or None."""
    best = None
    for path in _data_dir().glob("*/*.json"):
        payload = load_snapshot(path)
        if payload is None:
            continue
        try:
            # Ordering only, so mtime is a fair stand-in for a snapshot written
            # before `updated_at` existed. A reported AGE is not: see reading_age.
            when = payload.get("updated_at") or path.stat().st_mtime
        except OSError:
            continue
        if best is None or when > best[0]:
            best = (when, payload["session_id"])
    return best[1] if best else None


def resolve_session(arg):
    """Return (session_id, source). Positional arg > env > most recent snapshot."""
    if arg:
        return arg, "argument"
    for var in ("CLAUDE_CODE_SESSION_ID", "CLAUDE_SESSION_ID"):
        v = os.environ.get(var)
        if v:
            return v, var
    sid = newest_session()
    return (sid, "newest-snapshot") if sid else (None, None)


def find_snapshot(sid):
    """The snapshot for one session id, in whichever producer directory holds it.

    The producer level is globbed, not named: a session id is unique, so which
    program wrote the file is not part of its identity, and a harness added later
    is found for free (docs/telemetry-snapshots.md). Only the producer level is
    a wildcard - the id is escaped, so a target of `*` finds nothing rather than
    quietly reporting on whichever session sorts first."""
    for path in sorted(_data_dir().glob(f"*/{glob.escape(sid)}.json")):
        payload = load_snapshot(path)
        if payload is not None:
            return path, payload
    return None, None


def reading_age(payload):
    """Seconds since the reading was taken, or None when the snapshot says.

    Deliberately no mtime fallback. Snapshots are portable between machines, so
    mtime can be the time of a copy rather than of a reading, and a stale reading
    that looks fresh is worse than one that admits it does not know."""
    when = payload.get("updated_at")
    return None if when is None else time.time() - when


def humanize(n):
    """840 -> '840', 15700 -> '15.7k', 1000000 -> '1M'."""
    n = float(n)
    if n < 1000:
        return str(int(round(n)))
    if n < 1_000_000:
        v = n / 1000
        return f"{v:.0f}k" if v == int(v) else f"{v:.1f}k"
    v = n / 1_000_000
    return f"{v:.0f}M" if v == int(v) else f"{v:.1f}M"


def fmt_elapsed(seconds):
    seconds = int(round(seconds))
    if seconds < 60:
        return f"{seconds}s"
    m, s = divmod(seconds, 60)
    if m < 60:
        return f"{m}m{s:02d}s" if s else f"{m}m"
    h, m = divmod(m, 60)
    return f"{h}h{m:02d}m"


def metrics(payload):
    """Extract usage fields, or None when context data is absent (fresh/compacted)."""
    cw = payload.get("context_window") or {}
    size = cw.get("context_window_size") or 0
    if not size:
        return None
    used = (cw.get("total_input_tokens") or 0) + (cw.get("total_output_tokens") or 0)
    pct = cw.get("used_percentage")
    if pct is None:
        pct = used / size * 100
    return {"pct": pct, "used": used, "size": size}


AGE_UNKNOWN = "unknown"


def summary(m, age=None):
    """One usage line. `age` is seconds, AGE_UNKNOWN, or None to omit it."""
    parts = [f"{m['pct']:.0f}% ({humanize(m['used'])}/{humanize(m['size'])})"]
    if age == AGE_UNKNOWN:
        parts.append("snapshot age unknown")
    elif age is not None:
        parts.append(f"snapshot {fmt_elapsed(age)} old")
    return " | ".join(parts)


def cmd_status(args):
    sid, source = resolve_session(args.session)
    if not sid:
        print("No session id and no snapshots in data dir "
              "-- is the statusLine side-write installed?", file=sys.stderr)
        return 1
    path, payload = find_snapshot(sid)
    if payload is None:
        print("No snapshot yet. The statusLine side-write may not be wired up "
              "(see skills/token-aware/SKILL.md Setup) or no render has fired "
              "since this session started.")
        return 0
    m = metrics(payload)
    if m is None:
        print("Snapshot has no context_window data yet "
              "(fresh session or just compacted)")
        return 0
    age = reading_age(payload)
    print(summary(m, AGE_UNKNOWN if age is None else age))
    return 0


def cmd_watch(args):
    sid, source = resolve_session(args.session)
    if not sid:
        print("No session id and no snapshots in data dir "
              "-- is the statusLine side-write installed?", flush=True)
        return 1

    thresholds = sorted(set(args.thresholds)) if args.thresholds else list(DEFAULT_THRESHOLDS)

    prev = None
    armed = set()
    waiting = False
    path = None
    while True:
        # Re-resolve until a snapshot exists: watch may start before the session
        # has written its first one, and only then is its producer known.
        payload = load_snapshot(path) if path else None
        if payload is None:
            path, payload = find_snapshot(sid)
        m = metrics(payload) if payload else None
        now = time.time()

        if m is None:
            if not waiting:
                print("Waiting for first snapshot...",
                      flush=True)
                waiting = True
            time.sleep(args.interval)
            continue

        if prev is None:
            print("Start watch: " + summary(m), flush=True)
            prev = {"t": now, "pct": m["pct"], "used": m["used"]}
            armed = {t for t in thresholds if m["pct"] >= t}
            time.sleep(args.interval)
            continue

        for t in thresholds:
            if t in armed or m["pct"] < t:
                continue
            armed.add(t)
            dt = now - prev["t"]
            vel = (m["used"] - prev["used"]) / dt * 60 if dt > 0 else 0
            etas = []
            if vel > 0:
                for x in (x for x in thresholds if x > t):
                    target = x / 100 * m["size"]
                    if target > m["used"]:
                        etas.append(f"to {x:g}% ~{fmt_elapsed((target - m['used']) / vel * 60)}")
            eta = f", ETA {', '.join(etas)}" if etas else ""
            print(f"Crossed {t:g}%: {summary(m)} "
                  f"(+{fmt_elapsed(dt)} since {prev['pct']:.0f}%/{humanize(prev['used'])}, "
                  f"~{humanize(vel)}/min avg{eta})", flush=True)
            prev = {"t": now, "pct": m["pct"], "used": m["used"]}

        time.sleep(args.interval)


def main():
    ap = argparse.ArgumentParser(description="Report or watch this session's token usage")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status", help="Print a one-shot usage summary")
    s.add_argument("session", nargs="?", help="Session id (default: $CLAUDE_CODE_SESSION_ID)")
    s.set_defaults(func=cmd_status)

    w = sub.add_parser("watch", help="Stream milestone events for the Monitor tool")
    w.add_argument("session", nargs="?", help="Session id (default: $CLAUDE_CODE_SESSION_ID)")
    w.add_argument("--interval", type=float, default=5.0, help="Poll seconds (default 5)")
    w.add_argument("--threshold", "-t", type=float, action="append", dest="thresholds",
                   metavar="PCT", help="Milestone percent to alert on; repeatable "
                   "(default: 50 75 90 95)")
    w.set_defaults(func=cmd_watch)

    args = ap.parse_args()
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
